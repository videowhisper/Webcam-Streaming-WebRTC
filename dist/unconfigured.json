{
    "deny": "Please fill in your WebRTC server details in this config file and remove/empty the deny property to continue. Get a free developer account from https://webrtchost.com/hosting-plans/#WebRTC-Only",
    "channel": "{generate}",
    "username": "{generate}",
    "view": "BroadcastChat",
    "enableGET": true,
    "showURL": true,
    "randomChat": {
        "includeAnyOption": true,
        "collapseAfterMs": 10000,
        "roomPrefix": "Call",
        "filters": [
            {
                "label": "I am",
                "mirror": "Looking for",
                "options": "Male|Female"
            },
            {
                "label": "Language",
                "options": "English|Spanish|French|German|Portuguese|Italian|Hindi|Arabic|Japanese|Korean|Chinese"
            }
        ]
    },
    "videowhisperServer":{
        "socket": "WSS_VIDEOWHISPER_SERVER:PORT",
        "authentication": "token",
        "token": "ACCOUNT_TOKEN",
        "account": "ACCOUNT_NAME",
        "user": "USER_NAME",
        "pin": "USER_PIN"
    },
    "stream": {
        "width":640,
        "height":360,
        "framerate":15,
        "videoBitrate":500,
        "audioBitrate":32
    },
    "snapshots": {
        "enabled": false,
        "url": "",
        "timeout": 2000,
        "interval": 30000,
        "maxWidth": 0,
        "maxHeight": 0,
        "quality": 0.9
    },
    "development": false
}